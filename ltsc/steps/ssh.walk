walkthrough "windows 11 IoT LTSC - ssh"

# THIS FILE IS `11/steps/ssh.walk` WITH ONE THING CHANGED: THE WALKTHROUGH'S NAME AND ITS OUTPUT.
#
# THAT IS A MEASURED DECISION, NOT A SHORTCUT. Since the `-cpu`/`-smp` fix every step of the 11 file
# is a plain Windows operation - open powershell, winget-install OpenSSH, start the service, allow
# port 22, prove the account - and the IoT LTSC edition differs from 11 only in what it ships, not in
# how those commands work. A copy that drifted from the original would be two files to keep in step
# for no gain, so the two are deliberately identical apart from the lines above.
#
# `reference/desktop.png` IS THIS FAMILY'S OWN, which is the part that had to be separate: LTSC draws
# its own taskbar, and a comparison against 11's picture would either fail on a correct desktop or be
# loosened until it could not fail.
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var boot_timeout
  default "900"
  from args.boot_timeout
var out
  default out/windows11iot-ltsc-ssh.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222



step "take the input disk"
  disk disk.qcow2


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "wait for the desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 180
    pause 5


step "wake the screen"
  input esc
  settle 5


step "wake the screen again"
  input esc
  settle 3


step "open the run dialog"
  input meta_l+r
  settle 3


step "type powershell"
  settle 2
  input text powershell
  type_gap 0.15


step "open powershell"
  input ret
  settle 14


step "keep the screen on before ssh exists"
  settle 2
  input text "powercfg /change monitor-timeout-ac 0; powercfg /change monitor-timeout-dc 0; powercfg /change standby-timeout-ac 0; powercfg /change standby-timeout-dc 0; 'SCREEN=kept-on'"
  type_gap 0.15


step "run the screen setting"
  input ret
  settle 3


# BOTH INSTALLERS, WINGET FIRST - AND ON THIS EDITION IT WILL NOT BE THERE.
#
# MEASURED on run 45652133455, which is why this stage stopped using winget alone. Its recording:
#
#	PS C:\Users\vmuser> winget install --id Microsoft.OpenSSH.Preview ...
#	winget : The term 'winget' is not recognized as the name of a cmdlet, function, script file,
#	or operable program.
#	    + CategoryInfo : ObjectNotFound: (winget:String) [], CommandNotFoundException
#	WINGET_EXIT=0
#	WINGET_LOW=0
#
# `WINGET_EXIT=0` ON A COMMAND THAT NEVER RAN IS THE PART THAT MATTERS: `$LASTEXITCODE` kept its
# previous value, so the step that only looked at it blessed a machine with no sshd.
#
# THE CONDITION IS EVALUATED IN THE GUEST, NOT IN THIS FILE, because a walk cannot branch on what a
# command prints. `Add-WindowsCapability` comes from the image rather than a feed, which is what
# makes it the right fallback here, and the step after this asks `Get-Service sshd` for the verdict.
step "prove which package manager this edition ships"
  settle 2
  input text "(Get-Command winget -ErrorAction SilentlyContinue).Source; 'WINGET_PRESENT=' + [bool](Get-Command winget -ErrorAction SilentlyContinue)"
  type_gap 0.3


step "run that check"
  input ret
  settle 8


step "install openssh, with whichever installer this edition has"
  settle 2
  input text "if (Get-Command winget -ErrorAction SilentlyContinue) { winget install --id Microsoft.OpenSSH.Preview --exact --source winget --accept-source-agreements --accept-package-agreements --disable-interactivity } else { Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 | Select-Object -ExpandProperty RestartNeeded }; 'SSHD_PRESENT=' + [bool](Get-Service sshd -ErrorAction SilentlyContinue)"
  type_gap 0.2


step "run the install"
  input ret
  settle 180


# THE SERVICE IS THE VERDICT, NOT EITHER INSTALLER'S EXIT CODE.
step "the machine has an sshd service now"
  repeat
    do
      item "ask the service whether it exists"
        input text "clear; 'SSHD_PRESENT=' + [bool](Get-Service sshd -ErrorAction SilentlyContinue)"
      item
        input ret
        settle 10
      item "read the screen"
        read
          name sshdstate
    until
      bind up
      source sshdstate
      mode text
      # THE WHOLE SCREEN, BECAUSE THE ANSWER IS IN THE MIDDLE OF IT. `rect [0, 0, 1920, 200]` is the
      # top strip, where the menu bar and nothing else lives; the PowerShell window's last line is
      # around y=450..970. MEASURED on run 45666342842: `SSHD_PRESENT=True` was printed and read
      # THIRTEEN TIMES while this gate answered "the condition never held" - the service was there,
      # the check was looking at the wallpaper above it.
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[SSHD_PRESENT=True]]
    max 12


step "sshd starts automatically"
  run "Set-Service sshd -StartupType Automatic; (Get-Service sshd).StartType"
  settle 4
  type_gap 0.15


step "sshd takes passwords and port 22"
  run "$f = Join-Path $env:ProgramData 'ssh/sshd_config'; Add-Content -Path $f -Value 'PasswordAuthentication yes'; (Select-String -Path $f -Pattern PasswordAuthentication).Line"
  settle 4
  type_gap 0.15


step "sshd is running"
  run "Start-Service sshd; (Get-Service sshd).Status"
  settle 4
  type_gap 0.15


step "the firewall allows 22"
  run "New-NetFirewallRule -Name sshd22 -DisplayName OpenSSH22 -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -ErrorAction SilentlyContinue; Test-NetConnection localhost -Port 22 -InformationLevel Quiet"
  settle 4
  type_gap 0.15


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "do not blank the screen"
  ssh "powershell -Command \"powercfg /change monitor-timeout-ac 0; powercfg /change monitor-timeout-dc 0; powercfg /change standby-timeout-ac 0; powercfg /change standby-timeout-dc 0\""
  timeout 120


step "no hibernation file"
  ssh "powershell -Command \"powercfg -h off\""
  timeout 120


step "hold windows update"
  ssh "powershell -Command \"New-Item -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Force | Out-Null; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name NoAutoRebootWithLoggedOnUsers -Value 1 -Type DWord -Force; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name NoAutoUpdate -Value 1 -Type DWord -Force\""
  timeout 120


step "turn off restore points"
  ssh "powershell -Command \"Disable-ComputerRestore -Drive 'C:\\' -ErrorAction SilentlyContinue\""
  timeout 180


step "compact the component store"
  ssh "DISM /Online /Cleanup-Image /StartComponentCleanup"
  timeout 3600


step "prove the power settings took"
  ssh "powershell -Command \"$m = (powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 2>$null | Select-String 'Current AC Power Setting').ToString().Split(':')[-1].Trim(); $s = (powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE 2>$null | Select-String 'Current AC Power Setting').ToString().Split(':')[-1].Trim(); 'MONITOR=' + $m + ' STANDBY=' + $s + ' HIBER=' + (Test-Path C:\\hiberfil.sys)\""
  timeout 180


step "prove sshd is automatic"
  ssh "powershell -Command \"(Get-Service sshd).StartupType\""
  timeout 180


step "prove sshd is listening"
  ssh "netstat -ano | findstr LISTENING | findstr \":22 \""
  timeout 180


step "prove the account can log in"
  ssh whoami
  timeout 60


step "prove the build"
  ssh "powershell -Command \"[System.Environment]::OSVersion.Version.ToString()\""
  timeout 180


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
