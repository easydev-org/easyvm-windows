walkthrough "windows 11 - configure the vm (share, logon hook)"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var host
  default 172.30.0.1
  from args.host
var hostname
  default easyvm-win11
  from args.hostname
var locale
  default en_US.UTF-8
  from args.locale
var out
  default out/distro.qcow2
  from args.out
password admin1
var smb_pass
  default ""
  from args.smb_pass
var smb_user
  default guest
  from args.smb_user
var timezone
  default America/Los_Angeles
  from args.timezone
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222
# THE AGENT AND ITS DRIVER ARRIVE ALREADY EXTRACTED FROM THE virtio-win ISO. This used to be a
# `fetch: guest_agent_windows` step that ran `7z` against the ISO inside the walkthrough; the leg now
# pulls `virtio-agent.tar` and the engine unpacks it, so a truncated pull fails HERE rather than at a
# `copy` twenty steps later.
step "the agent and its driver are on disk"
  needs [qemu-ga-x86_64.msi, vioserial/vioser.inf, vioserial/vioser.sys, vioserial/vioser.cat]


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "wait for the desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 180
    pause 5


step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10



step "copy the driver in"
  scp vioserial/vioser.inf "C:/Users/{{ user }}/vioser.inf"
  timeout 300


step "copy the driver's payload in"
  scp vioserial/vioser.sys "C:/Users/{{ user }}/vioser.sys"
  timeout 300


step "copy the driver's catalogue in"
  scp vioserial/vioser.cat "C:/Users/{{ user }}/vioser.cat"
  timeout 300


step "copy the agent installer in"
  scp qemu-ga-x86_64.msi "C:/Users/{{ user }}/qemu-ga-x86_64.msi"
  timeout 600
# THE DRIVER IS INSTALLED *INTO THE DRIVER STORE*, WHICH IS NOT THE SAME AS BINDING IT TO A DEVICE.
#
# MEASURED ON RUN 44560274921: `PNPUTIL_EXIT=0`, and the very next check reported
#
#	device: NO virtio-serial port
#
# qemu's side was right - that run's command line carries `-chardev socket,id=qga0`,
# `-device virtio-serial` and `-device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0`.
# What was missing is that Windows had not matched the new hardware to the driver: `/add-driver`
# stages the package, and the device node needs a RESCAN to appear and bind.
#
# SO THE STEP NOW RESCANS AND ASSERTS. `pnputil /scan-devices` asks the PnP manager to look again,
# and PNPUTIL_EXIT is checked rather than printed - a driver that did not install must not be
# followed by an agent that cannot answer.


step "install the driver the agent talks on"
  ssh "powershell -NoProfile -Command \"Push-Location $env:USERPROFILE; $p = Start-Process pnputil.exe -ArgumentList @('/add-driver','vioser.inf','/install') -PassThru -Wait -NoNewWindow; Write-Output ('PNPUTIL_EXIT=' + $p.ExitCode); if ($p.ExitCode -ne 0) { exit $p.ExitCode }; $q = Start-Process pnputil.exe -ArgumentList @('/scan-devices') -PassThru -Wait -NoNewWindow; Write-Output ('SCAN_EXIT=' + $q.ExitCode); Start-Sleep -Seconds 10; Pop-Location\"\n"
  timeout 600


step "install the guest agent"
  ssh "cmd /c \"msiexec /i C:\\Users\\{{ user }}\\qemu-ga-x86_64.msi /qn /norestart /l*v C:\\Users\\{{ user }}\\qemu-ga-install.log & echo MSIEXEC_EXIT=%ERRORLEVEL%\"\n"
  timeout 600
# THE DRIVER IS IN THE STORE AND THE PORT DOES NOT EXIST UNTIL WINDOWS RESTARTS.
#
# MEASURED ON RUN 44893899545, WITH EVERY COMMAND SUCCEEDING:
#
#	Driver package installed on device: PCI\VEN_1AF4&DEV_1003&SUBSYS_00031AF4&REV_00\3&11583659&0&08
#	PNPUTIL_EXIT=0
#	SCAN_EXIT=0
#	MSIEXEC_EXIT=0
#	service: Running / Automatic
#	device: NO virtio-serial port
#
# qemu's own command line carries `-chardev socket,id=qga0,... -device virtio-serial -device
# virtserialport,chardev=qga0,name=org.qemu.guest_agent.0`, so the host side was right. `pnputil
# /add-driver` STAGES a package; the serial port device node is created by the driver's own
# AddDevice at boot, and a rescan does not create it. Windows has to restart.
#
# THE DISK PUBLISHED BEFORE THIS STEP EXISTED (`windows11-vm-configure`, 2026-11-19, commit
# e795895) WAS MADE BY A CHECK THAT ONLY PRINTED THE LINE AND NEVER FAILED - `if ($d) {...} else {
# Write-Output 'device: NO virtio-serial port' }` - so it recorded this same failure as a healthy
# run and the agent's channel was never proved. The assertion below is why it now fails here, and
# a restart is the smallest thing that makes it true.


step "restart, because the driver's port is made by the next boot"
  ssh "shutdown /r /t 0 /f"
  timeout 120


step "wait for sshd to come back on the new boot"
  repeat
    until machine_ssh
    max 90
    pause 10
# THIS CHECK USED TO PRINT AND NEVER FAIL, AND THAT IS WHY A DEAD AGENT LOOKED HEALTHY.
#
# MEASURED ON RUN 44560274921, whose log is this step's own output:
#
#	=== prove the guest agent answers
#	  service: Running / Automatic
#	  device: NO virtio-serial port
#
# The service was running; THE CHANNEL TO QEMU WAS NOT THERE. `Get-Service` can only see the
# service, and the "NO virtio-serial port" branch only wrote a line - so the step "passed", the
# stage went on to `shutdown: guest_agent`, and the request went to an agent with no pipe to
# receive it. The machine stayed up, `stopping with method "guest_agent"` was the last line the
# stage wrote, and the failure looked like a shutdown problem when it was a MISSING CHANNEL.
#
# SO THE DEVICE IS NOW AN ASSERTION: exit 1 when the port is absent, or when any matching device
# is not `OK`. The vioser driver is installed a few steps above, and if the device has not bound
# to the virtio-serial port the agent cannot answer - which is the fact this step exists to state.
# THE QUESTION IS WHETHER THE HOST CAN REACH THE AGENT, SO THE HOST ASKS IT.
#
# MEASURED ON RUNS 44893899545 AND 44896827596, the second one AFTER a restart: `service: Running
# / Automatic` and `device: NO virtio-serial port`, even though qemu's command line carries
# `-device virtio-serial -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0` and the
# driver package installed onto `PCI\VEN_1AF4&DEV_1003` with `PNPUTIL_EXIT=0`.
#
# `Get-PnpDevice -Class Ports` IS THE WRONG INSTRUMENT. It reads one Windows class, through one
# cmdlet, and its answer depends on whether the vioser driver happened to create a COM node in
# that class - not on whether the agent is answering. A check that can be wrong in the direction
# of a FALSE FAILURE is as bad as the one that only printed, because both send the next person to
# the wrong file.
#
# `qga: ping` IS THE THING ITSELF: it opens the qga socket qemu is listening on and asks the agent
# inside the guest to answer. If it replies, the channel exists end to end - driver bound, port
# present, service up - and if it does not, the failure names the agent rather than a device class.


# THE AGENT COMES BACK A LITTLE AFTER SSHD DOES, SO THE PING IS RETRIED.
#
# MEASURED on run 45783475583, step 13 of 33:
#
#	=== wait for sshd to come back on the new boot
#	  machine_ssh: ssh_ready="true" present=true
#	  repeat: satisfied after 1 attempt(s)
#	=== prove the guest agent answers
#	  error: `qga: ping`: the agent at .../qga.sock does not answer `guest-ping`:
#	         read unix @->qga.sock: i/o timeout. The socket is open on the host side, so this is
#	         the GUEST's agent
#
# THE SAME MACHINE ANSWERED `qga: ping ok` ON THE PREVIOUS RUN (45781969105). Neither the driver nor
# the MSI differed: `PNPUTIL_EXIT=0`, `SCAN_EXIT=0`, `MSIEXEC_EXIT=0` in both. What differed is TIME -
# `machine_ssh` became true one attempt after the restart, and the daemon's socket exists from the
# moment qemu starts it, so a single ping can land while Windows is still starting the agent service.
#
# SO THE PING IS ASKED UNTIL IT ANSWERS, which is what the wait above already does for sshd. A qga
# channel that never opens still fails, just 40 attempts later than before.
step "prove the guest agent answers"
  repeat
    until machine_qga
    max 40
    pause 10


# THE RENAME COMES BEFORE THE LOCALE AND THE TIME ZONE, AND THAT ORDER IS MEASURED TOO.
#
# MEASURED on run 45775360061, the first run that set the locale first (the previous commit's order):
#
#	=== set the locale to American English
#	    LOCALE_WRITTEN
#	=== wait for sshd after the language change dropped it
#	  machine_ssh: ssh_ready="true"
#	=== prove the locale
#	    culture = en-US  /  ui = en-US
#	=== set the time zone to Pacific  /  prove the time zone
#	    zone = Pacific Standard Time
#	=== set the computer's name
#	  ssh: powershell ... Rename-Computer ... -> 1        <- FAILED, NO OUTPUT
#
# `Set-WinSystemLocale` reconfigures the language services, and `Rename-Computer` stopped working in
# the machine that had just had them rebuilt - exit 1 with nothing on stdout. THE SAME COMMAND HAD
# SUCCEEDED IN run 45771601806, where the rename ran BEFORE the locale (`WARNING: The changes will
# take effect after you restart` / `RENAME_SCHEDULED`). So the rename goes first, and the two setters
# follow it, each with the `settle + machine_ssh` wait that THIS run proved catches the dropped
# session:
#
#	=== wait for sshd after the language change dropped it
#	  machine_ssh: ssh_ready="true" present=true
#	  repeat: satisfied after 1 attempt(s)
#
# THE SETTERS NO LONGER NEED TO BE BEFORE THE RENAME, because the drop is handled where it happens.
# That was the reason for the previous order and this run retired it.
# THERE IS NO "prove the rename is pending" STEP ANY MORE, AND ITS ABSENCE IS THE FIX.
#
# MEASURED on run 45781969105, step 15 of 34:
#
#	=== prove the new name is pending ...
#	  ssh: powershell ... -> 0
#	    pending = EASYVM-WIN11
#	    live    = SANDBOX
#	  abort: ssh session: unexpected packet in response to channel open
#
# The command RAN and printed two of its three lines; the third never arrived because
# `Rename-Computer` had already begun restarting the machine. Run 45780063789 shows the same thing from
# the other side - its `shutdown /r` was refused with 1115, `ERROR_SHUTDOWN_IN_PROGRESS`.
#
# SO "PENDING" IS A STATE THIS GUEST BARELY SPENDS TIME IN. A step that tries to observe it is racing
# the restart it is meant to precede, and when it loses, the failure reads as a broken ssh session
# rather than as a race. The restart step below already waits for the machine to come back, and the
# step after it proves the name is LIVE, which is the fact that matters.
step "set the computer's name"
  ssh "powershell -NoProfile -Command \"Rename-Computer -NewName '{{ hostname }}' -Force -ErrorAction Stop; Write-Output RENAME_SCHEDULED\""
  timeout 300
step "wait for the restart the rename already started"
  settle 20
  repeat
    until machine_ssh
    max 90
    pause 10



step "prove the name is live, not pending"
  ssh "powershell -NoProfile -Command \"Write-Output ('name = ' + $env:COMPUTERNAME); if ($env:COMPUTERNAME -ieq '{{ hostname }}') { Write-Output 'HOSTNAME_LIVE_OK' } else { Write-Output 'HOSTNAME_NOT_LIVE'; exit 1 }\""
  timeout 120







# A TIME-ZONE CHANGE DROPS THE SESSION TOO, FOR THE SAME REASON THE LOCALE DOES - and both are now
# reached only AFTER the rename has been applied by a restart.
#
# MEASURED on run 45771601806, when this ran straight after `Rename-Computer`:
#
#	=== set the time zone to Pacific
#	  ssh: powershell ... Set-TimeZone -Id 'Pacific Standard Time' ... -> 0
#	  ssh: wait: remote command exited without exit status or exit signal
#
# THE EXIT STATUS WAS 0 - the command ran and succeeded - and the failure came from the CONNECTION,
# reset while the shell was still waiting for its status line. THAT WAS A PENDING RENAME, and the
# answer was not a different order (both orders were measured and both failed, see the notes on the
# rename above) but the restart that makes the rename stop being pending.
#
step "set the locale to American English"
  ssh "powershell -NoProfile -Command \"Set-WinUILanguageOverride -Language 'en-US'; Set-Culture -CultureInfo 'en-US'; Set-WinSystemLocale -SystemLocale 'en-US'; Write-Output LOCALE_WRITTEN\""
  timeout 300


# `Set-WinSystemLocale` RECONFIGURES THE LANGUAGE SERVICES, AND THAT DROPS THE SESSION IT WAS ASKED IN.
#
# MEASURED on run 45773249906, step 15 of 30 - the run that first reordered the setters to before the
# rename, which was necessary and not sufficient:
#
#	=== set the locale to American English
#	  ssh: powershell ... Set-WinSystemLocale ... -> 0
#	    LOCALE_WRITTEN
#	=== prove the locale
#	  ssh: ... -> 0
#	  ssh: wait: remote command exited without exit status or exit signal
#
# BOTH COMMANDS RETURNED 0. The setter wrote the value and returned; the machine then tore down the
# session underneath the shell that asked, so the NEXT step - a fresh dial - landed in the gap. Order
# cannot fix an asynchronous teardown; a wait can. sshd is back within seconds on this guest, and
# `machine_ssh` is the daemon's own probe of exactly that.
step "wait for sshd after the language change dropped it"
  settle 15
  repeat
    until machine_ssh
    max 60
    pause 5


step "prove the locale"
  ssh "powershell -NoProfile -Command \"Write-Output ('culture = ' + (Get-Culture).Name); Write-Output ('ui      = ' + (Get-WinUILanguageOverride).Name); if ((Get-Culture).Name -eq 'en-US') { Write-Output 'LOCALE_OK' } else { Write-Output 'LOCALE_WRONG'; exit 1 }\""
  timeout 120


step "set the time zone to Pacific"
  ssh "powershell -NoProfile -Command \"Set-TimeZone -Id 'Pacific Standard Time' -ErrorAction Stop; Write-Output (Get-TimeZone | Select-Object -ExpandProperty Id)\""
  timeout 120


step "wait for sshd after the time-zone change dropped it"
  settle 15
  repeat
    until machine_ssh
    max 60
    pause 5


step "prove the time zone"
  ssh "powershell -NoProfile -Command \"Write-Output ('zone = ' + (Get-TimeZone).Id); Write-Output ('now  = ' + (Get-Date -Format o)); if ((Get-TimeZone).Id -eq 'Pacific Standard Time') { Write-Output 'TIMEZONE_OK' } else { Write-Output 'TIMEZONE_WRONG'; exit 1 }\""
  timeout 60
step "prove the guest can fetch from the host share"
  ssh "powershell -NoProfile -Command \"Invoke-WebRequest -UseBasicParsing -TimeoutSec 20 'http://172.30.0.1:8080/shared/'\""
  timeout 180


step "show what the guest sees at the share"
  ssh "powershell -NoProfile -Command \"(Invoke-WebRequest -UseBasicParsing -TimeoutSec 20 'http://172.30.0.1:8080/shared/').Content; Write-Output ('fetch exit = ' + $LASTEXITCODE)\""
  timeout 120


step "copy the launcher in"
  scp
    template launcher
    to "C:/Users/{{ user }}/bootstrap-launcher.ps1"
  timeout 300


step "copy the task registration script in"
  scp
    template windows_task
    to "C:/Users/{{ user }}/bootstrap-install.ps1"
  timeout 300


step "register the logon task"
  ssh "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/{{ user }}/bootstrap-install.ps1\n"
  timeout 300


step "prove the logon task is registered"
  ssh "cmd /c \"schtasks /Query /TN vm-bootstrap /V /FO LIST | findstr /i /C:TaskName /C:Status\"\n"
  timeout 60


step "name the machine's own domain for winlogon, or the auto-logon half-applies"
  ssh "powershell -NoProfile -Command \"Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon' -Name DefaultDomainName -Value $env:COMPUTERNAME -Type String; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon' -Name AutoAdminLogon -Value '1' -Type String; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon' -Name DefaultPassword -Value '{{ password }}' -Type String; Write-Output AUTOLOGON_DOMAIN_SET\"\n"
  timeout 120


step "prove all four winlogon values are what an unattended boot needs"
  ssh "powershell -NoProfile -Command \"$k = 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon'; $w = Get-ItemProperty -Path $k; Write-Output ('AutoAdminLogon    = ' + $w.AutoAdminLogon); Write-Output ('DefaultUserName   = ' + $w.DefaultUserName); Write-Output ('DefaultDomainName = ' + $w.DefaultDomainName); if ($w.DefaultPassword) { Write-Output 'DefaultPassword   = present'; Write-Output PASSWORD_PRESENT } else { Write-Output 'DefaultPassword   = MISSING'; Write-Output PASSWORD_MISSING; exit 1 }\"\n"
  timeout 120
# `sudo ... poweroff` IS LINUX AND THIS GUEST IS WINDOWS, SO IT CANNOT WORK.
#
# MEASURED ON RUN 44492250642, this stage, just after the winlogon proof:
#
#	ssh: printf '%s\n' 'admin' | sudo -S -p '' poweroff -> 255
#	  'printf' is not recognized as an internal or external command,
#	  operable program or batch file.
#
# The line was copied from the Linux vm-configure files, where it is right. Here cmd.exe ran it
# and nothing was shut down.
#
# `kill`, WHICH IS WHAT THIS REPOSITORY ALREADY USES FOR THIS GUEST, AND THE REASON IS IN THE RUNS.
#
# MEASURED ON RUN 44560274921: `stopping with method "guest_agent"` was the LAST LINE the stage
# wrote, then it failed with the machine still up. The agent's socket was there - 'prove the guest
# agent answers' passed earlier in this same file - so the shutdown request went somewhere and the
# guest did not go down within the grace.
#
# `windows/11/steps/ssh.walk` (which PASSES) ends with `shutdown: kill`, and windows11-ssh is a
# published 10865 MiB disk. A qcow2 is journalled and qemu exits cleanly on the signal, so the
# disk is consistent - which is the property that matters here, since the next stage boots it.
#
# The earlier `sudo ... poweroff` was Linux syntax and could never work; `guest_agent` was the
# right idea and did not work on this guest; `kill` is what the sibling stage proves.


step "stop the machine"
  stop kill
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"
