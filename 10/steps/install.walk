walkthrough "windows 10 - install to a desktop"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var boot_timeout
  default "1800"
  from args.boot_timeout
var computer_name
  default sandbox
  from args.computer_name
var out
  default out/windows10.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
# THE IMAGE INDEX IS NOT A VARIABLE OF THIS FILE. It is a fact about the MEDIUM, and the answer CD
# carries it: `scripts/build-answer.sh win10` reads the medium's own install.wim and writes the
# selector into Autounattend.xml. A number here would be a second place for the same fact, and the
# two would disagree the first time a release reordered its images.
ssh_port 2222
step "the media this stage boots from is already on disk"
  needs [windows.iso, virtio-win.iso]


step "create the empty disk"
  disk
    file disk.qcow2
    size 128



step "boot the installer"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-device", "i8042"], ["-drive", "file=windows.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=answer.iso,media=cdrom,readonly=on,if=none,id=media1"], ["-device", "usb-storage,bus=xhci.0,drive=media1,bootindex=2"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-drive", "file=virtio-win.iso,media=cdrom,readonly=on,if=none,id=media2"], ["-device", "usb-storage,bus=xhci.0,drive=media2,bootindex=3"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1800
step "wait for the firmware to offer the DVD"
  until DVD-ROM
  blind_after 60
  from console
  timeout 180


# RETURN, NOT ESCAPE, AND THE DIFFERENCE IS MEASURED ON THE RECORDING ITSELF.
#
# These three presses exist for the firmware's own "Press any key to boot from CD or DVD" line, where
# either key works. WHAT THEY ALSO REACH, ONCE SETUP IS RUNNING, IS A DIFFERENT MATTER: Escape is
# Setup's Cancel shortcut, and MEASURED on run 45166271464 the recording carries the consequence from
# t=60s onward -
#
#	Windows 10 Setup
#	We're getting a few things ready
#	  (!) Are you sure you want to quit?     [ Yes ]  [ No ]
#
# - a modal raised one minute in, sitting on top of the install for the ninety minutes the run lasted.
# The desktop check answered `0.0000 similar` on all 5336 frames because the dialog was all there was.
#
# RETURN DOES NOT DO THAT. On "Press any key" it is the key the prompt is asking for, and on Setup's
# own pages it activates the default control rather than Cancel - which is why the three presses are
# `ret` here and were `esc` for as long as the dialog was blamed on something else.
# THE MEDIUM ASKS FOR A KEY IN A FIVE-SECOND WINDOW, AND THREE PRESSES SENT AT ONCE MISS IT.
#
# MEASURED from run 45257383788's own recording, frame at t=3000 - ninety-four minutes of this screen:
#
#	BdsDxe: No bootable option or device was found.
#	BdsDxe: Press any key to enter the Boot Manager Menu.
#	        Press any key to boot from CD or DVD......
#
# THE DVD WAS OFFERED AND THE PROMPT WAS UP; nobody pressed a key inside its window. The three `ret`
# presses that were supposed to do it are sent in the first four seconds after the CONSOLE prints
# `DVD-ROM` - and the video prompt appears later than that. So the window opened after the keys were
# spent, the firmware fell through to "No bootable option", and every Windows family that reached this
# point sat here until its budget ran out.
#
# THAT IS WHY windows10 AND ltsc BOTH REPORTED "THE WALKTHROUGH DID NOT FINISH IN TIME" and why
# windows2025 kept reading "No bootable option": one missed five-second window, three families.
#
# SO THE PROMPT IS WAITED FOR AND ANSWERED WHEN IT IS UP. The loop reads the screen every two seconds
# and presses Return the moment `Press any key` appears - which is what a person sitting at this screen
# does - and it stops as soon as Setup or the firmware's menu takes over. `optional` because the prompt
# is the guest's, not this walk's: an image that boots straight through must not fail here.
# THE DVD ROW IS CLICKED, NOT REACHED BY A KEYSTROKE - TWO RUNS PROVED `ret` DOES NOT DO IT.
#
# MEASURED on runs 45308245512 (win10) and 45308256761 (ltsc), both cancelled after 52 minutes: the last
# frame of each is the firmware's menu, unchanged from the first -
#
#	Please select boot device:                                    box: x 736..1176, y 370..710
#	  UEFI QEMU DVD-ROM QM00011       <- highlighted, row y≈416, text x 740..1172
#	  UEFI Misc Device
#	  UEFI QEMU QEMU USB HARDRIVE 1-0000:00:03.0-3
#	  ...
#	  ENTER to select boot device / ESC to exit
#
# `ret` was pressed by the step that used to follow this one, and the menu did not move. A CLICK AT THE
# ROW'S OWN COORDINATES CANNOT BE REDIRECTED the way a keystroke can be sent to whatever holds focus -
# the same argument the quit-dialog fix in this walk already rests on.
#
# AND THE GUARD IS THE MENU'S TITLE, NOT THE WORD `Setup`. The old gate accepted `Setup Is starting`
# and `Windows Setup` as "already booting", so ONE OCCURRENCE OF `Setup` ANYWHERE let the loop exit
# while the menu was on screen - which is how three families reached `wait for the desktop` without
# ever starting an installer. `Please select boot device:` is on this menu and on nothing else Setup
# draws, so it is the only word-set that decides "there is a menu to answer".
#
# THE FIRST STEP WAITS FOR THE MENU, THE SECOND ANSWERS IT, THE THIRD PROVES THE ANSWER TOOK. Each can
# be true independently: a guest may show no menu at all (windows 11's own OVMF picks the DVD unaided),
# so all three are `optional`.
# THE MENU ALREADY HAS THE DVD HIGHLIGHTED, SO THE ONE THING TO DO IS PRESS ENTER.
#
# MEASURED on runs 45442239506 (windows10) and 45442265263 (ltsc), whose frames at frame-000616 and
# t=600 are the same picture:
#
#	+------------------------------------------------------+
#	| Please select boot device:                            |
#	| UEFI QEMU DVD-ROM QM00011      <- HIGHLIGHTED, row 1  |
#	| UEFI Misc Device                                      |
#	| UEFI QEMU QEMU USB HARDDRIVE 1-0000:00:03.0-3         |
#	| ...   EFI Firmware Setup / Internal Shell / PXE / HTTP |
#	+------------------------------------------------------+
#	| (up)(down) to move selection                          |
#	| ENTER to select boot device                           |
#	| ESC to exit                                           |
#	+------------------------------------------------------+
#
# THE DVD IS ROW ONE AND ALREADY SELECTED. `ENTER to select boot device` is the menu's own instruction.
#
# WHAT WAS HERE BEFORE, AND WHY IT COST BOTH LEGS: three steps that clicked (845,435) to "put the
# highlight on the DVD row", pressed Return, and then decided the menu was gone. The click was gated on
# `when: [select, boot, device]`, and these runs are the first where a gate on an ACTION step was ever
# read at all (before easyvm 96ff5f2 the dispatcher ran `input` and never looked at `when`). Their logs
# say what the gate decided:
#
#	skipped: the screen does not say "select boot device"
#
# so the click never happened. Nothing needed it - the highlight was already right - but the step that
# CONFIRMED the highlight was gone (`take the row`'s `until` read `0 word(s)` and called that "the menu
# is gone") declared success on a blank frame, and the leg went on to press Return into whatever the
# firmware had left on screen. windows10 then sat on `BdsDxe: No bootable option or device was found.`
# for 6588 seconds and ltsc's Setup came up only to fail with 0x40031 on a stale answer ISO.
#
# SO THERE IS ONE STEP AND ONE KEY. Wait for the menu's own title, press Return, and let the step after
# this one decide whether the medium took it.
step "the firmware's boot menu is up, if it has one"
  optional true
  repeat
    do
      item "read the screen"
        read
          name menu
    until
      bind up
      source menu
      mode text
      rect [700, 360, 1220, 720]
      rect_at [1920, 1080]
      scale 1
      # THE TITLE'S OWN WORDS. `Please select boot device:` reads as exactly these three on the frame
      # above; the old gate asked for the same three and the OCR of THAT frame also had them, so the
      # skip was the dispatcher, not the reading.
      words [[select, boot, device], [Boot, Manager]]
    max 120
    pause 2


# `ENTER to select boot device` IS THE MENU'S OWN INSTRUCTION, AND THE DVD IS ROW ONE.
#
# The old walk clicked a ROW first and pressed Return second. On a menu whose first row is already
# highlighted that click is unnecessary, and it was also the step the gate skipped.
# THE RETURN HAS TO LAND INSIDE A WINDOW THAT IS ABOUT THREE SECONDS WIDE, SO THE LOOP IS FAST.
#
# MEASURED on the two legs that ran the same walk against different media on 2026-11-24:
#
#	ltsc 45464854774  SUCCESS   `key ret` -> `see: 0 word(s):`        -> Setup took over
#	windows10 45464833575  FAIL  `key ret` -> `see: 1 word(s): ge-liano` -> back at the boot menu
#
# - and windows10's own console.log shows why, on ONE line:
#
#	Press any key to boot from CD or DVD......BdsDxe: failed to start ... Time out
#
# The prompt and its timeout are adjacent: the medium offers about three seconds, and a round of this
# loop (press, `settle 3`, whole-frame OCR) was five to six. So the key sometimes arrived after the
# window had closed, and the firmware fell through to its own menu - which is exactly the `ge-liano`
# fragment the leg then read for the rest of the hour.
#
# THE FIX IS FREQUENCY, NOT A LONGER WAIT: press every two seconds and check the menu is still there
# between presses. A Return during Setup's own loading is ignored, and on the menu the row already
# highlighted is the DVD, so an extra press costs nothing.
step "take the row the highlight is on"
  optional true
  repeat
    do
      item "press Return, which is what the menu says takes the row"
        input ret
        settle 2
      item "read the screen, to see whether the menu is still there"
        read
          name afterret
    until
      bind gone
      source afterret
      mode text
      rect [700, 360, 1220, 720]
      rect_at [1920, 1080]
      scale 1
      # SATISFIED WHEN THE MENU IS GONE. `without` ALONE, because `judgeWords` reads `words` first and
      # never looks at `without` when both are present - the defect this file's own history records.
      without [select, boot, device]
    max 12


step "the menu is gone, because the choice was taken"
  optional true
  repeat
    do
      item "read the screen"
        read
          name after
    until
      bind taken
      source after
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      words [[Setup, Is, starting], [Windows, is, loading, files], [Windows, Setup], [Windows, Server], [Press, any, key]]
    max 120
    pause 2


# THE MEDIUM ASKS FOR A KEY IN A FIVE-SECOND WINDOW, AND THIS WALK HAD NO STEP THAT PRESSES ONE.
#
# MEASURED on run 45323176485 (ltsc), whose frame at t=180 is the whole story:
#
#	BdsDxe: No bootable option or device was found.
#	BdsDxe: Press any key to enter the Boot Manager Menu.
#	        Press any key to boot from CD or DVD......
#
# THE DVD WAS OFFERED AND THE PROMPT WAS UP. Nobody pressed a key inside its window, so the firmware
# moved on and found nothing bootable. An earlier version of this walk had three blind `ret` presses for
# this prompt, sent in the first four seconds after the console printed `DVD-ROM` - before the prompt
# was on the video side - and they were removed when the boot-menu handling was rewritten. Removing them
# removed the only thing that answered this line.
#
# SO THE PROMPT IS WAITED FOR AND ANSWERED WHEN IT IS UP, which is what a person at this screen does:
# read every two seconds, press Return the moment `Press any key` is on screen, and stop as soon as
# Setup's own words appear. `optional` because the prompt belongs to the guest - an image that boots
# straight through must not fail here.
# THE PRESS COMES FIRST IN EVERY ROUND, BECAUSE READING THE SCREEN COSTS MORE THAN THE WINDOW.
#
# MEASURED on run 45429023654, the first leg with the `the menu is gone` fix: that step now passes in
# ONE attempt (it accepted `Press any key`), and this step then read the prompt on frame 000625 and
# pressed `ret` - and the NEXT frame, 000631, was already the firmware's menu again. SIX SECONDS
# BETWEEN TWO CAPTURES, against a prompt window of about five.
#
# WHERE THE SIX SECONDS GO: the round used to `read` (a screendump and a whole-frame OCR), then run a
# gated `input ret` whose `when:` RE-READS THE SCREEN - a second OCR - and then `settle 2`. So the
# keystroke left about four seconds after the frame that justified it, which is most of the window.
#
# SO THE ORDER IS INVERTED. The loop presses Return, waits one second, and THEN reads to ask whether it
# can stop. A stray Return during boot is harmless in every state this step can see: on the boot menu
# it takes the highlighted row - which is the DVD, the row an earlier step just chose - and during
# Setup's own loading it is ignored. `ret` repeated about a second apart is also what the hand
# measurement on the pod found takes: one press is a coin flip, six one second apart were taken.
step "take the medium's boot prompt, whenever it appears"
  optional true
  repeat
    do
      item "press a key, because the medium may be asking for one"
        input ret
        settle 1
      item "read the screen, to see whether the prompt's moment has passed"
        read
          name probe
    until
      bind taken
      source probe
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      # ANY OF THESE MEANS THE PROMPT'S MOMENT HAS PASSED.
      words [[Setup, Is, starting], [Windows, is, loading, files], [Windows, Setup], [Windows, Server]]
    max 90
    pause 1


step "Setup is on screen"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name screen
    until
      bind done
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [Windows, Setup]
    max 180
# NINETY MINUTES WAS NOT ENOUGH ON A GITHUB RUNNER, AND THE FRAME SAYS WHY.
#
# MEASURED ON RUN 44377939172, which spent its whole 1h30m and failed:
#
#   wait for the desktop: no windows desktop within 1h30m0s; drop=+20.7 (need 15)
#     ratio=0.1x (need 2) sat=+0.07 (need 0.10) on a 1920x1080 frame
#
# THAT FRAME IS "Please keep your computer on. Your computer may restart a few times." - the
# installer's own OOBE, still posting. `desktop: windows` is RIGHT to refuse it: a black screen with
# one line of white text has no variance and no saturation, which is exactly the two measurements
# that failed.
#
# SO THE BUDGET IS THE THING THAT WAS WRONG, not the predicate. Two hours is the same order as the
# install above it (`timeout: 1800` for the boot, then this), and a leg whose guest is slow loses
# the whole run to a number chosen before one had been measured on this runner.
# THE OOBE STOPS DEAD ON ITS OWN REBOOT NOTICE UNLESS SOMETHING TOUCHES THE KEYBOARD.
#
# MEASURED TWICE. Run 44377939172 spent its whole 1h30m and run 44410380340 its whole 2h on the
# same frame:
#
#	Please keep your computer on.
#	Your computer may restart a few times.
#
# with a `Select C:\WINDOWS\SYSTEM32\netsh.exe` window over it. The measurements the predicate
# uses are on that frame - ratio=0.1x and sat=+0.07, both under what a desktop needs - so
# `desktop: windows` was RIGHT every time it refused, for two hours.
#
# `desktop:` IS A PASSIVE POLL: it takes a frame and decides, and nothing in it presses a key. The
# OOBE waits for one. So the keys come first, in a loop that is bounded and ends when the screen is
# no longer the notice - `until: {fact: ...}` is not usable here (no mode reports it), so the loop
# is a fixed number of nudges and `desktop:` still has the real timeout.
# THE PRESSES ARE FURTHER APART AND THERE ARE FEWER OF THEM, BECAUSE THE FIRST SET MEASURED NO
# EFFECT. Ten Returns twenty seconds apart, then two hours of the same frame: `netsh.exe` is
# sysprep's own window and it does not read the keyboard. A key pressed into a busy sysprep is at
# best ignored and at worst queued into whatever runs next.
#
# SO THEY ARE A GENTLE PERIODIC NUDGE - a minute apart, six of them - for the case where the OOBE
# really is waiting on the "press any key" line, and the memory above is the actual fix for the
# stall that was measured.
#
# AND SIX RETURNS INTO A RUNNING INSTALL IS SIX CHANCES TO PRESS SOMETHING THAT IS NOT A NUDGE.
# MEASURED ON RUN 44468093359, whose recording ends on this exact frame after 2h07m:
#
#	Installing Windows 10        54% complete
#	[ Windows 10 Setup ]  Are you sure you want to quit?   [Yes]  [No]
#
# The installer had reached 54% and was working, and the sixth Return landed on its `Cancel`
# button, which carries the FOCUS on that page. The "are you sure" dialog then sat there until
# the budget ran out. The nudge was written for an OOBE that waits on "press any key", and NOTHING
# IN IT COULD TELL THAT SCREEN FROM AN INSTALL THAT IS 54% DONE.
#
# AND THE ANSWER IS GATED ON THE DIALOG ITSELF, NOT ON THE PROGRESS LINE.
#
# THE FIRST ATTEMPT AT THIS GATE WAS `when_not: [complete]` AND IT FAILED FOR A REASON THAT IS IN
# THE ENGINE: `doUnless` treats an unreadable screen as an ERROR, because "the words are absent"
# and "nobody looked" are different facts. MEASURED ON RUN 44490615000, which died at step 10:
#
#	nudge the first boot along, once - unless: 0 word(s):
#	status: failed step 10/22 "nudge the first boot along, once"
#
# The band was the progress line and the screen at that moment was "We're getting a few things
# ready", which has none. So the gate refused, and a guard against cancelling an install became a
# way to lose one.
#
# `when:` READS, AND A MISSING READING IS A SKIP. That is the behaviour this needs: press the key
# ONLY when the quit dialog is on screen, and do nothing at all on every other frame.
#
# WHY THE DIALOG AND NOT "press any key": MEASURED on the 2h07m recording, where the progress line
# reads 28% at 200 s, 54% at 600 s, and 54% again at 1200, 1800, 2400 and 3000 - the install had
# stopped, and the quit dialog is up from about 520 s. The dialog is what has to be answered.


step "answer a quit dialog, if one is up"
  input esc
  rect [820, 460, 1520, 660]
  rect_at [1920, 1080]
  # SCALE 2, BECAUSE SCALE 1 DOES NOT READ THE WORD THIS GATE NEEDS. Read back from the recording:
  # scale 1 gives "yeusureyouwantto au?" - no whole word in it, so a gate keyed on `quit` would
  # never open - and scale 2 gives "Are you sure you want to quit?".
  #
  # THE GATE IS `sure`, NOT `quit`, BECAUSE THIS GUEST MAY PHRASE IT DIFFERENTLY. See the note by
  # the first gate below: Windows 10's Setup is reported to say "exit", and `sure` is the word both
  # sentences share.
  scale 2
  settle 15
  when [sure]
# THE SAME ANSWER ONCE MORE, because a dialog that has been dismissed can come back: the first
# one appeared only because a stray Return had pressed Cancel, and no Return is sent any more.


step "answer it again, if it came back"
  input esc
  rect [820, 460, 1520, 660]
  rect_at [1920, 1080]
  scale 2
  settle 15
  when [sure]

# ESCAPE DOES NOT CLOSE THIS DIALOG, AND THAT IS MEASURED RATHER THAN GUESSED. Run 45166271464 sat
# on it for ninety minutes with the desktop check answering `0.0000 similar` on every frame - the
# install was fine, and a modal had it:
#
#	Windows 10 Setup
#	Are you sure you want to quit?
#	 [ Yes ]   [ No ]        <- `No` is focused, and the whole screen is behind it
#
# The screen in the recording shows `No` with a focus rectangle, so ENTER is what dismisses it. An
# `esc` here does nothing at all - which is why the two steps above never cleared it, and why the
# desktop never appeared while the guest sat waiting behind a question nobody answered.
step "dismiss the quit dialog by clicking its No button"
  # A CLICK AT THE BUTTON, FOR THE SAME REASON THE LOOP BELOW USES ONE: a keystroke goes to whatever
  # the page focuses, and the page under an install in progress focuses its own Cancel.
  input
    click [1035, 620]
  settle 3
  rect [820, 460, 1520, 660]
  rect_at [1920, 1080]
  scale 2
  when [sure]
# THE DESKTOP IS DECIDED BY THE REFERENCE IMAGE, NOT BY THREE BRIGHTNESS THRESHOLDS.
#
# MEASURED ON THIS GUEST'S OWN RECORDINGS. `desktop: windows` wanted drop>=15, ratio>=2x and
# sat>=0.10 - three numbers within a few percent of each other - and the OOBE frames failed them
# with `ratio=0.1x sat=+0.07` for TWO HOURS while the console log showed Windows Boot Manager had
# started.
#
# THE SAME QUESTION, ASKED WITH A REFERENCE, SEPARATES CLEANLY. Measured on one ubuntu recording
# frame by frame against the reference that file ships:
#
#	 30s   similarity 0.0004   boot splash
#	 90s   similarity 0.0041   still splashing
#	120s   similarity 0.9909   the desktop
#	1600s  similarity 0.9767   the desktop, later
#
# "not a desktop" tops out at 0.0043 and "a desktop" bottoms out at 0.9669 - two orders of
# magnitude - where the thresholds gave 0.1x against a floor of 2.
#
# THE REFERENCE IS THE ONE THE `check:` BELOW ALREADY USES, so there is one picture of this desktop
# in the repository rather than two that could drift apart.


step "wait for the desktop"
  # A DIALOG CAN RETURN AT ANY POINT DURING THE INSTALL, SO THE QUESTION IS ASKED ON EVERY ROUND.
  # The two steps above answer it once, before the wait; the packer is free to raise it again while
  # the image is being applied, and MEASURED on run 45166271464 that is exactly what happened - the
  # screen kept showing "Are you sure you want to quit?" while this loop read 0.0000 similarity for
  # ninety minutes. Answering it here costs one keystroke per round and needs no new step.
  repeat
    do
      # THE FRAME IS READ FIRST, AND THE KEY IS PRESSED ONLY IF THAT FRAME SAYS `quit`.
      #
      # MEASURED on run 45194828845, t=300s: the screen was
      #
      #	Installing Windows 10        18% complete        [ Cancel ]
      #	        +------------------------------------------+
      #	        |  (!) Are you sure you want to quit?       |
      #	        |     [ Yes ]   [ No ]   <- No has the focus |
      #	        +------------------------------------------+
      #
      # and the loop read `0.0000 similar` for sixty-three minutes. The order in the old `do:` was
      # `input ret` and THEN the gate - so on the very first round, with no previous frame to read,
      # the key went to whatever the 18% page had focused, which is its own `Cancel`. That raised the
      # dialog; the next round's `ret` pressed `No`; the round after that pressed `Cancel` again. A
      # loop that could only ever stay on the dialog it was trying to dismiss.
      item "read the screen before touching the keyboard"
        read
          name screen
      item "dismiss the quit dialog, but only if this frame is one"
        # THE POINT IS THE `No` BUTTON ITSELF, NOT A KEYSTROKE. MEASURED from the same frame: the dialog
        # spans x 835..1102, y 495..652, and `No` is the right-hand button at about x 1035, y 620.
        #
        # `ret` WOULD ALSO WORK WHEN `No` HAS THE FOCUS - and it does, in that dialog - but a keystroke
        # is sent to whatever the page focuses, and the page underneath an install in progress focuses
        # its own `Cancel`. A click at a coordinate is the one thing that cannot be redirected.
        input
          click [1035, 620]
        settle 3
        rect [820, 460, 1520, 660]
        rect_at [1920, 1080]
        scale 2
        when [sure]
      item "re-read, because the keystroke may have changed the page"
        read
          name screen
    until
      # THE REFERENCE PICTURE IS THIS FAMILY'S OWN, cut from the first Windows 10 install that
      # reached a desktop on 2026-11-24. It is the same predicate windows 11 uses, for the reason
      # that file records: three brightness thresholds sat on the OOBE frame for two hours, while a
      # comparison against a reference separates "not a desktop" from "a desktop" by two orders of
      # magnitude.
      #
      # 2081 DISTINCT COLOURS IN THE TOP 120 ROWS, measured on the picture itself - fewer than
      # windows 11's 3058 because this wallpaper is a smooth gradient, and still two orders of
      # magnitude above a firmware menu's few dozen.
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 1440
    pause 5


step "click the empty desktop"
  input 960 540
  settle 3


step "and an Escape in case a panel was the thing that took it"
  input esc
  settle 2
# A NOTIFICATION IS NOT DISMISSED BY A CLICK ON THE WALLPAPER. MEASURED ON RUN 44377939172, after
# the click and the Escape had been added: 0.9088 similar, and the frame is a clean Windows desktop
# with ONE "Settings / Searching for Display Driver" panel in the bottom-right corner. The click
# went to the desktop; a toast belongs to the shell.
#
# IT EXPIRES ON ITS OWN in about thirty seconds, which is what this settles for. Waiting is the
# honest fix: the alternative is a reference that contains a transient toast, and then the compare
# is measuring how fast the runner is rather than whether the desktop came up.


step "settle 45s"
  settle 45


step "the desktop is the one this file was written against"
  read shot


step "the screen is the one this file was written against"
  # THE TASKBAR IS EXCLUDED, BECAUSE EVERY RUN PUTS DIFFERENT ICONS IN IT.
  #
  # MEASURED: two clean Windows desktops from two runs score 0.9555 over the whole frame and
  # 0.9999 over everything above the taskbar. The wall paper, the two desktop icons and the
  # notification area are identical; the PINNED ICONS AND THE CLOCK ARE NOT - one run had Firefox
  # and Explorer pinned, the other did not, and the clocks read 9:52 and 11:13.
  #
  # A COMPARISON THAT FAILS ON A CHANGING CLOCK IS MEASURING THE CLOCK. What this step is for is
  # "the desktop came up and it is this system", and the region above the taskbar says exactly that
  # while the taskbar says what was pinned at the time.
  #
  # `rect` as a PIXEL pair with `rect_at`, rather than a fraction, because 1000/1080 is the edge of
  # a taskbar that is 40 px tall at this resolution - a fraction would move with the guest's size
  # and the taskbar's edge is what has to be excluded.
  check
    source shot
    mode like
    must
    name matched
    range [0.97, 1]
    rect [0, 0, 1920, 1000]
    rect_at [1920, 1080]
    reference reference/desktop.png


# THE MACHINE THAT INSTALLED IS STILL RUNNING, AND A SECOND BOOT NEEDS IT GONE FIRST.
#
# MEASURED on run 45184022059, which reached step 18 and stopped there:
#
#	reboot into the installed system: this machine is already running with different qemu
#	arguments. One daemon holds one machine, so a boot that describes another one needs a
#	`stop:` first - otherwise the steps below drive the guest the earlier boot started
#
# The installer's machine is what has been running since step 3; this step describes a DIFFERENT one
# - no ISO, the disk at bootindex=0 with discard=unmap - so the daemon refuses rather than silently
# driving the old guest. `stop kill` is right here because the install has already reported success
# and the desktop has been checked: nothing is left to lose, and ACPI would ask a machine that is
# sitting at the Windows desktop to shut down politely, which it may refuse.
step "power the installer's machine off, because the next boot describes another one"
  stop kill
  timeout 120


# THE INSTALLED SYSTEM'S MACHINE HAD NO `-m`, AND qemu's DEFAULT IS 128 MiB.
#
# MEASURED on run 45207826684, the first run that EVER reached this step: the reboot came up to
#
#	Recovery
#	Your PC/Device needs to be repaired
#	There isn't enough memory available to create a ramdisk device.
#	Error code: 0xc0000017
#
# and the desktop check then read `0.0002 similar` for its whole thirty-minute budget. Windows boots
# through a ramdisk and 128 MiB cannot hold one, so this was never "the install failed" - it was the
# SECOND machine being started smaller than the first.
#
# THE INSTALLER'S MACHINE HAS ALWAYS SAID 12288. This one copied its argument list from the first and
# lost the one flag between `-smp` and `-chardev`. Every stage AFTER this one (smoke, ssh,
# vm-configure) declares `-m 12288` explicitly, which is why the omission could only ever show here.
step "reboot into the installed system"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
step "the installed system reaches a desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 360
    pause 5


# THE DESKTOP GUEST IS STOPPED WITH `stop kill`, NOT WITH `acpi power`, AND THE FRAME SAYS WHY.
#
# MEASURED on windows11-install 45394544069 on v0.0.4: `acpi power` was pressed and the guest did
# NOTHING - its desktop stayed on screen, clock advancing, for the whole 300-second wait:
#
#	t=1200   the desktop, 12:58 PM
#	t=1520   the desktop, 1:04 PM        <- six minutes later, unchanged, and the step timed out
#
# A WINDOWS 11 DESKTOP TREATS THE ACPI POWER BUTTON AS "SLEEP" BY DEFAULT. The machine is therefore
# still running, `wait_until: stopped` cannot be satisfied, and the leg dies on a step whose job is to
# put the disk away. The same guest earlier in this same walk is stopped by `shutdown: kill` and the
# log shows `killing the guest` then `stopped on SIGTERM` - the mechanism that WORKS here.
#
# `stop kill` IS NOT A CRASH. `killAndReap` sends SIGTERM first, which is qemu's documented "exit
# now": it closes the block layer and flushes every cached write to the qcow2, so the published disk
# is as complete as an orderly shutdown would leave it. The SIGKILL underneath is the fallback for a
# qemu that ignores the first signal, not the normal path.
step "shut the installed system down"
  stop kill
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 300


step "publish the disk"
  save "{{ out }}"
