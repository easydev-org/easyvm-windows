# DOES THE PUBLISHED DISK START? Boot it, look, and kill it - nothing else.
#
# "THE INSTALL LEG PASSED" IS NOT THE SAME CLAIM. An install can answer every one of its steps and
# still publish a disk no firmware will boot:
#
#	BdsDxe: failed to load Boot0002 "UEFI QEMU HARDDISK QM00011" ... : Not Found
#	BdsDxe: No bootable option or device was found.
#
# MEASURED on android blissos 16.9.7: "Congratulations!" on screen, a complete loader tree in the
# ESP, and an unbootable disk - the loader was in /EFI/BLISSOS and an empty NVRAM looks only at
# \EFI\BOOT\BOOTX64.EFI.
#
# SO THIS ASKS ONE QUESTION: does the machine get off the ground? It does not log in and does not
# click; its artifact is the recording. `stage.yml` runs it with `out:` empty, which is what makes
# "no disk to publish" a success rather than a warning.
#
# THE BOOT ARGUMENTS ARE ssh.walk's, DELIBERATELY. A smoke test that boots a DIFFERENT machine from
# the one the next stage does is measuring itself rather than the artifact: the target disk is
# bootindex=0 with discard=unmap, no installer medium is attached, and the variables store is the
# fresh copy every later stage gets.
walkthrough "the published disk starts - nothing else"
resolution 1920x1080
recording_resolution 1920x1080

step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 300

# `BdsDxe: starting` IS THE FIRMWARE SAYING IT FOUND SOMETHING BOOTABLE, and a disk it cannot start
# prints the opposite sentence on the same console. That is the difference between a boot and a black
# screen, and it is a better witness than any brightness threshold.
step "the firmware handed control to the disk"
  until "BdsDxe: starting"
  from console
  timeout 300

# THE DESKTOP IS THE CLAIM, AND THIS STEP USED TO MAKE A WEAKER ONE.
#
# IT WAS `settle 180` AND NOTHING ELSE, with a comment arguing that every guest draws a different boot
# sequence so no screen check could be written. THAT ARGUMENT WAS RIGHT ABOUT A GENERIC THRESHOLD AND
# WRONG ABOUT THIS REPOSITORY, which ships `reference/desktop.png` for exactly this family and uses it
# in `ssh.walk`.
#
# MEASURED on run 45469938194, which this walk reported as SUCCESS: its own recording is 184 seconds
# long and the frame at t=175 is still the TianoCore splash. THE GUEST NEVER REACHED A DESKTOP and the
# walk could not have known, because the only thing it checked was `BdsDxe: starting` - a console line
# the firmware prints before it has loaded anything at all.
#
# THE COST WAS REAL: `windows11` was published from a leg this walk blessed, and the ssh leg that
# pulled it spent its whole budget reading `Preparing Automatic Repair` - 179 readings, all
# 0.0000 similar. A smoke that cannot fail on a disk that does not boot is not a smoke.
#
# SO THE SAME PICTURE TEST `ssh.walk` USES IS USED HERE. `reference/desktop.png` is this family's own
# desktop at 1920x1080, and `range [0.9, 1]` is what `wait for the desktop` in ssh.walk already asks.
# The budget is 180 attempts of 5 seconds, the same fifteen minutes.
step "the disk reaches a desktop"
  repeat
    do
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.9, 1]
      rect [0, 0, 1920, 120]
      rect_at [1920, 1080]
      must true
    max 180
    pause 5

step "stop the machine"
  # KILL, NOT ACPI: this machine never reached userspace on purpose, and a clean shutdown would be a
  # second claim about a disk this walk is not testing.
  stop kill
  timeout 120
