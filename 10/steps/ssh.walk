walkthrough "windows 10 - ssh"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var boot_timeout
  default "900"
  from args.boot_timeout
var out
  default out/windows10-ssh.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
boot_disk from_caller
ssh_port 2222



step "take the input disk"
  disk disk.qcow2


step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "12288"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900
# THE REFERENCE PICTURE IS HERE NOW: `reference/desktop.png`, 729654 bytes, taken from this family's
# own install recording on 2024-11-24.
#
# IT HAD TO BE ITS OWN. Windows 10 draws a different taskbar and a different wallpaper from 11, so the
# 11 file could not be borrowed - a comparison against it would either fail on a correct desktop or
# be loosened until it could not fail. The block that used to sit here said the file was missing and
# that this stage could not pass until it existed; it exists, so the sentence is gone rather than left
# to mislead the next reader.
step "wait for the desktop"
  repeat
    do
      # WINDOWS 10 PUTS A "Networks" PANE OVER THE RIGHT-HAND SIDE OF ITS FIRST DESKTOP, and Escape
      # closes it. MEASURED on run 45651981387: the desktop WAS on screen at t=200 - wallpaper, task
      # bar, "Type here to search", Recycle Bin and Edge - with that pane laid over the right third,
      # and the comparison below answered `0.0000 similar` fifty-two times until the leg timed out.
      #
      # THE ESCAPE IS INSIDE THE LOOP rather than before it, because the pane arrives when the
      # network stack first comes up and that is not at a fixed moment. A key that closes nothing is
      # harmless; a pane that was never closed fails the whole stage.
      item
        input esc
        settle 2
      item
        read
          name screen
    until
      source screen
      mode like
      reference reference/desktop.png
      range [0.85, 1]
      # THE LEFT TWO THIRDS ONLY. The right third holds the Networks pane on a first boot and the
      # clock at all times - the reference picture carries `8:41 AM` and a later boot carries its own
      # time, so any comparison that includes it is comparing two correct desktops and losing.
      rect [0, 0, 1280, 120]
      rect_at [1920, 1080]
      must true
    # A BOOT THAT STOPS AT THE FIRMWARE SPLASH IS NOT A WALK FAILURE, AND IT HAPPENS. MEASURED on run
    # 45665239012: the SAME `windows10` disk that reached a desktop in 200 seconds on the run before
    # spent its whole budget on
    #
    #	BdsDxe: starting Boot0002 "UEFI Misc Device"
    #	TianoCore ... (spinning)
    #
    # with `-cpu Skylake-Client-v4 -smp 4` in the qemu line - so it is not the processor this time,
    # which is what it was for `windows11`. The guest simply did not take control, and a reset clears
    # that.
    #
    # SO TEN MINUTES IN, THE GUEST IS RESET ONCE. `nudge` fires at most once, so a disk that genuinely
    # cannot boot still fails at the ceiling instead of looping forever.
    max 180
    pause 5
    nudge 600
      item "wake the firmware, in case it stopped at the splash"
        input ret
        settle 3
      item "reset the guest"
        acpi reset
        timeout 300
      item "give it time to come back"
        settle 60


step "wake the screen"
  input esc
  settle 5


step "wake the screen again"
  input esc
  settle 3


step "open the run dialog"
  input meta_l+r
  settle 3


step "type powershell"
  settle 2
  input text powershell
  type_gap 0.15


step "open powershell"
  input ret
  settle 14


step "keep the screen on before ssh exists"
  settle 2
  input text "powercfg /change monitor-timeout-ac 0; powercfg /change monitor-timeout-dc 0; powercfg /change standby-timeout-ac 0; powercfg /change standby-timeout-dc 0; 'SCREEN=kept-on'"
  type_gap 0.15


step "run the screen setting"
  input ret
  settle 3


# BOTH INSTALLERS, WINGET FIRST, AND THE REASON IS ONE SCREEN FROM IoT LTSC.
#
# THE ANSWER TO "CAN WE JUST USE winget" IS NO, AND IT IS MEASURED RATHER THAN PREFERRED. On
# `windows11` winget is present and `winget install --id Microsoft.OpenSSH.Preview` produced a working
# sshd - that leg passed 29/29. On IoT LTSC THE COMMAND DOES NOT EXIST, and the recording says so:
#
#	PS C:\Users\vmuser> winget install --id Microsoft.OpenSSH.Preview ...
#	winget : The term 'winget' is not recognized as the name of a cmdlet, function, script file,
#	or operable program.
#	    + CategoryInfo : ObjectNotFound: (winget:String) [], CommandNotFoundException
#	WINGET_EXIT=0
#	WINGET_LOW=0
#
# AND THAT `WINGET_EXIT=0` IS THE REAL DANGER: THE COMMAND DID NOT RUN, AND THE EXIT CODE SAID IT
# SUCCEEDED. `$LASTEXITCODE` was never set by anything, so it kept its previous value. A step that
# only looked at the exit code would have blessed a machine with no sshd - which is exactly how the
# first LTSC run failed forty steps later at `wait for sshd`.
#
# SO THE EDITION IS ASKED FIRST AND THE ANSWER PICKS THE INSTALLER:
#
#	winget present   -> `winget install --id Microsoft.OpenSSH.Preview`, the path proven on windows11
#	winget absent    -> `Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0`, which comes
#	                    from the image rather than a feed
#
# AND THE RESULT IS JUDGED BY THE SERVICE, NOT BY AN EXIT CODE. `Get-Service sshd` either finds it or
# does not; that cannot be faked by a command that never ran.
step "prove which package manager this edition ships"
  settle 2
  input text "(Get-Command winget -ErrorAction SilentlyContinue).Source; 'WINGET_PRESENT=' + [bool](Get-Command winget -ErrorAction SilentlyContinue)"
  type_gap 0.3


step "run that check"
  input ret
  settle 8


step "what state does this image report for OpenSSH.Server"
  settle 2
  input text "Get-WindowsCapability -Online -Name OpenSSH.Server* | ForEach-Object { $_.Name + ' = ' + $_.State }"
  type_gap 0.3


step "run the state check"
  input ret
  settle 10


# ONE COMMAND THAT TRIES winget AND FALLS BACK, SO THE CHOICE IS MADE BY THE GUEST RATHER THAN BY A
# CONDITION THIS FILE CANNOT EVALUATE. `-ErrorAction SilentlyContinue` plus the explicit re-check is
# what keeps a missing command from being read as success.
step "install openssh, with whichever installer this edition has"
  settle 2
  input text "if (Get-Command winget -ErrorAction SilentlyContinue) { winget install --id Microsoft.OpenSSH.Preview --exact --source winget --accept-source-agreements --accept-package-agreements --disable-interactivity } else { Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 | Select-Object -ExpandProperty RestartNeeded }; 'SSHD_PRESENT=' + [bool](Get-Service sshd -ErrorAction SilentlyContinue)"
  type_gap 0.2


step "run the install"
  input ret
  settle 180


# THE SERVICE IS THE VERDICT. `Add-WindowsCapability` on Windows 10's consumer media can source its
# payload from Windows Update, and this guest has no route off the host - so the call can return
# having installed nothing. Neither installer's exit code is trusted here; `Get-Service` is.
step "the machine has an sshd service now"
  repeat
    do
      item "ask the service whether it exists"
        input text "clear; 'SSHD_PRESENT=' + [bool](Get-Service sshd -ErrorAction SilentlyContinue)"
      item
        input ret
        settle 10
      item "read the screen"
        read
          name sshdstate
    until
      bind up
      source sshdstate
      mode text
      # THE WHOLE SCREEN, BECAUSE THE ANSWER IS IN THE MIDDLE OF IT. `rect [0, 0, 1920, 200]` is the
      # top strip, where the menu bar and nothing else lives; the PowerShell window's last line is
      # around y=450..970. MEASURED on run 45666342842: `SSHD_PRESENT=True` was printed and read
      # THIRTEEN TIMES while this gate answered "the condition never held" - the service was there,
      # the check was looking at the wallpaper above it.
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[SSHD_PRESENT=True]]
    max 12


step "sshd starts automatically"
  run "Set-Service sshd -StartupType Automatic; (Get-Service sshd).StartType"
  settle 4
  type_gap 0.15


step "sshd takes passwords and port 22"
  run "$f = Join-Path $env:ProgramData 'ssh/sshd_config'; Add-Content -Path $f -Value 'PasswordAuthentication yes'; (Select-String -Path $f -Pattern PasswordAuthentication).Line"
  settle 4
  type_gap 0.15


step "sshd is running"
  run "Start-Service sshd; (Get-Service sshd).Status"
  settle 4
  type_gap 0.15


step "the firewall allows 22"
  run "New-NetFirewallRule -Name sshd22 -DisplayName OpenSSH22 -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -ErrorAction SilentlyContinue; Test-NetConnection localhost -Port 22 -InformationLevel Quiet"
  settle 4
  type_gap 0.15


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "do not blank the screen"
  ssh "powershell -Command \"powercfg /change monitor-timeout-ac 0; powercfg /change monitor-timeout-dc 0; powercfg /change standby-timeout-ac 0; powercfg /change standby-timeout-dc 0\""
  timeout 120


step "no hibernation file"
  ssh "powershell -Command \"powercfg -h off\""
  timeout 120


step "hold windows update"
  ssh "powershell -Command \"New-Item -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Force | Out-Null; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name NoAutoRebootWithLoggedOnUsers -Value 1 -Type DWord -Force; Set-ItemProperty -Path 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' -Name NoAutoUpdate -Value 1 -Type DWord -Force\""
  timeout 120


step "turn off restore points"
  ssh "powershell -Command \"Disable-ComputerRestore -Drive 'C:\\' -ErrorAction SilentlyContinue\""
  timeout 180


step "compact the component store"
  ssh "DISM /Online /Cleanup-Image /StartComponentCleanup"
  timeout 3600


step "prove the power settings took"
  ssh "powershell -Command \"$m = (powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 2>$null | Select-String 'Current AC Power Setting').ToString().Split(':')[-1].Trim(); $s = (powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE 2>$null | Select-String 'Current AC Power Setting').ToString().Split(':')[-1].Trim(); 'MONITOR=' + $m + ' STANDBY=' + $s + ' HIBER=' + (Test-Path C:\\hiberfil.sys)\""
  timeout 180


step "prove sshd is automatic"
  ssh "powershell -Command \"(Get-Service sshd).StartupType\""
  timeout 180


step "prove sshd is listening"
  ssh "netstat -ano | findstr LISTENING | findstr \":22 \""
  timeout 180


step "prove the account can log in"
  ssh whoami
  timeout 60


step "prove the build"
  ssh "powershell -Command \"[System.Environment]::OSVersion.Version.ToString()\""
  timeout 180


step "stop the machine"
  stop kill
  timeout 120


step "publish the disk"
    save "{{ out }}"
